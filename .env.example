# Carrot Quest — админка → Разработчикам (формат "app.<id>.<секрет>";
# app_id для опроса /apps/{app_id}/conversations извлекается из него же)
CARROTQUEST_AUTH_TOKEN=

# Suvvy.ai — Каналы → Персональный канал (API)
SUVVY_API_TOKEN=
SUVVY_WEBHOOK_SECRET=

# Придумай сам — секрет для защиты /poll/tick (его дёргает внешний cron,
# см. bridge/README.md), любая случайная строка
POLL_SECRET=

# Как часто опрашивать Carrot Quest на новые сообщения (сек) — используется
# только фоновым потоком (run_forever), не влияет на /poll/tick
POLL_INTERVAL_SECONDS=5

# Порт, на котором слушает сервер моста
PORT=8000
